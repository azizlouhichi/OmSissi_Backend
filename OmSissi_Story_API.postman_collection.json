			"name": "Authentication",
			"item": [
				{
					"name": "Register Parent",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.token) {",
									"        pm.environment.set(\"token\", response.data.token);",
									"        pm.environment.set(\"parentId\", response.data._id);",
									"        console.log(\"Token saved:\", response.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Parent\",\n  \"email\": \"parent@test.com\",\n  \"password\": \"Test123!\",\n  \"parentalPIN\": \"1234\",\n  \"acceptedTerms\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/parents/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
